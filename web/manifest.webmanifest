{
  "id": "./app.html",
  "name": "Kaye · shop notebook",
  "short_name": "Kaye",
  "description": "Snap a page of your sales notebook. Gemini Nano reads it on your device, checks the math and keeps your books, even with no signal.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "app.html#home",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f5f7fc",
  "theme_color": "#00209F",
  "categories": ["business", "finance", "productivity"],
  "icons": [
    { "src": "assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "assets/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "assets/icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "assets/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "assets/logo.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "screenshots": [
    { "src": "assets/screens/desktop-month.jpg", "sizes": "800x499", "type": "image/jpeg", "form_factor": "wide", "label": "Month record: sales, costs, profit, best sellers and where the AI ran" },
    { "src": "assets/screens/desktop-owed.jpg", "sizes": "800x499", "type": "image/jpeg", "form_factor": "wide", "label": "Who owes me: credit and payments, with a polite reminder" },
    { "src": "assets/screens/phone-today.jpg", "sizes": "375x812", "type": "image/jpeg", "form_factor": "narrow", "label": "Today: sales, costs, profit and money owed" },
    { "src": "assets/screens/phone-month.jpg", "sizes": "375x812", "type": "image/jpeg", "form_factor": "narrow", "label": "Month record, built from your notebook" }
  ],
  "shortcuts": [
    { "name": "Snap a page", "short_name": "Snap", "description": "Photograph a notebook page or a receipt", "url": "app.html#snap", "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Quick note", "short_name": "Note", "description": "Type or say what you sold", "url": "app.html#note", "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Who owes me", "short_name": "Owed", "url": "app.html#owed", "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Month record", "short_name": "Month", "url": "app.html#month", "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "files": [{ "name": "photo", "accept": ["image/png", "image/jpeg", ".png", ".jpg", ".jpeg"] }] }
  },
  "file_handlers": [
    { "action": "app.html#snap", "accept": { "image/png": [".png"], "image/jpeg": [".jpg", ".jpeg"] } }
  ],
  "launch_handler": { "client_mode": "focus-existing" }
}
